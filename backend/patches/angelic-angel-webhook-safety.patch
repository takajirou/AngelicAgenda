+/// Returns whether the decrypted X Web Push payload represents a tweet.
+///
+/// Filtering here prevents unrelated notifications from leaving the listener
+/// process. The webhook repeats this validation as a trust-boundary check.
+fn is_tweet_notification(payload: &serde_json::Value) -> bool {
+    payload
+        .get("data")
+        .and_then(|data| data.get("type"))
+        .and_then(serde_json::Value::as_str)
+        == Some("tweet")
+}
